{
  "name": "feastdocs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node tools/dev.mjs",
    "serve": "ng serve",
    "build": "npm run docs:build && ng build && node tools/prerender.mjs",
    "docs:build": "node tools/build-content.mjs",
    "docs:new": "node tools/new-doc.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "npm run docs:build && ng test",
    "format": "prettier --write .",
    "template:sync": "node tools/sync-template.mjs",
    "upgrade": "node tools/upgrade.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.20",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "mermaid": "^11.17.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^28.0.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "prettier": "^3.8.1",
    "sass": "^1.102.0",
    "shiki": "^4.4.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
